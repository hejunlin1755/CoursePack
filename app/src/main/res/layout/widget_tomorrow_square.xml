<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    android:background="@drawable/widget_progress_background"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_day_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/widget_today_bag"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_progress_text_secondary" />

        <ImageView
            android:id="@+id/widget_complete_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:src="@drawable/ic_check"
            android:tint="@color/widget_progress_surface"
            android:background="@drawable/widget_complete_badge"
            android:contentDescription="@string/widget_all_packed"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/widget_progress_text"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/widget_segments"
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:textSize="12sp"
        android:textColor="@color/widget_progress_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
